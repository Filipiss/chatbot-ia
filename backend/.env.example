# Integrador de IA - Configurações Regionais
PORT=8000
HOST=127.0.0.1

# Chave mestra de criptografia do servidor para proteção das API Keys
SECRET_KEY=sua-chave-secreta-de-criptografia-aqui

# Deixe DATABASE_URL vazio para usar SQLite local em desenvolvimento
DATABASE_URL=

# Chaves de API das IAs (Protegidas estritamente no servidor)
GEMINI_API_KEY=sua-chave-gemini-aqui
OPENAI_API_KEY=sua-chave-openai-ou-groq-aqui
